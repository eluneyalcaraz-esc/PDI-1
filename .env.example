# Copiar este archivo a ".env" y ajustar los valores si es necesario

# Configuración de la base de datos

# Motor de base de datos: mysql o pgsql
DB_DRIVER=mysql

DB_HOST=localhost

# Puertos por defecto:
# mysql = 3306
# pgsql = 5432
DB_PORT=3306

DB_NAME=slim_php
DB_USER=root
DB_PASS=root

# PIN compartido del panel administrativo; usá un valor largo y difícil de adivinar
ADMIN_PIN=replace-with-a-long-random-pin

# Checkout Pro centralizado de Mercado Pago.
# Dejá estos valores vacíos para mantener los pagos deshabilitados.
# APP_URL debe ser el dominio público HTTPS de Emprendi para que el webhook llegue al sitio.
APP_URL=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
